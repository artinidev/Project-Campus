# ========================================
# Campus Superia - Docker Environment Setup
# ========================================

# App Configuration
PORT=5000

# Database Configuration (matches docker-compose.yml `db` credentials)
DB_HOST=db
DB_USER=root
DB_PASSWORD=secretpassword
DB_NAME=campus_superia_db

# MySQL Root Configuration required for the Docker container setup
MYSQL_ROOT_PASSWORD=secretpassword
MYSQL_DATABASE=campus_superia_db
MYSQL_USER=campus_user
MYSQL_PASSWORD=secretpassword
